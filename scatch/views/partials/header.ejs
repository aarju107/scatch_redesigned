<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scatch | Premium Bags &amp; Travel Goods</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <link href="/css/style.css" rel="stylesheet" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        ink: '#17140F',
                        paper: '#FAF7F1',
                        card: '#FFFFFF',
                        muted: '#8B8377',
                        line: '#E8E1D4',
                        accent: '#B8562D',
                        accentdark: '#93441F',
                    },
                    fontFamily: {
                        heading: ['"Playfair Display"', 'serif'],
                        sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'],
                    },
                    boxShadow: {
                        soft: '0 2px 14px rgba(23,20,15,0.06)',
                        card: '0 14px 34px -10px rgba(23,20,15,0.16)',
                        lift: '0 24px 50px -14px rgba(23,20,15,0.30)',
                    },
                },
            },
        };
    </script>
</head>

<body class="font-sans bg-paper text-ink antialiased overflow-x-hidden min-h-screen flex flex-col">

    <%
    var loggedin = typeof loggedin !== 'undefined' ? loggedin : true;
    var variant = typeof variant !== 'undefined' ? variant : 'store';
    %>

    <% if (variant !== 'owner') { %>
    <div class="bg-ink text-paper/90 text-[11px] md:text-xs tracking-[0.18em] uppercase text-center py-2 px-4">
        Free shipping on every order &nbsp;•&nbsp; Crafted for everyday carry
    </div>
    <% } %>

    <header class="sticky top-0 z-40 w-full bg-paper/90 backdrop-blur border-b border-line">
        <nav class="w-full flex items-center justify-between px-5 md:px-10 lg:px-16 py-4">

            <a href="<%= variant === 'owner' ? '/owners/admin' : '/' %>" class="flex items-center gap-2 shrink-0 group">
                <span class="w-9 h-9 rounded-full bg-ink text-paper flex items-center justify-center text-sm group-hover:bg-accent transition-colors duration-300">
                    <i class="ri-shopping-bag-3-fill"></i>
                </span>
                <span class="font-heading text-2xl leading-none text-ink">
                    Scatch<span class="text-accent">.</span>
                </span>
                <% if (variant === 'owner') { %>
                    <span class="hidden sm:inline-block ml-2 text-[11px] uppercase tracking-widest text-muted border border-line rounded-full px-2.5 py-1">Admin</span>
                <% } %>
            </a>

            <% if (variant === 'owner') { %>
                <div class="hidden md:flex items-center gap-6 text-sm">
                    <a href="/" class="text-ink/70 hover:text-ink transition-colors duration-200">
                        <i class="ri-store-2-line mr-1"></i> View store
                    </a>
                    <a href="/owners/logout" class="inline-flex items-center gap-1.5 text-red-600/90 hover:text-red-700 transition-colors duration-200">
                        <i class="ri-logout-box-r-line"></i> Logout
                    </a>
                </div>
            <% } else if (loggedin) { %>
                <div class="hidden md:flex items-center gap-8 text-sm font-medium">
                    <a href="/shop" class="relative text-ink/80 hover:text-ink transition-colors duration-200 after:content-[''] after:absolute after:left-0 after:-bottom-1 after:h-[1.5px] after:w-0 hover:after:w-full after:bg-accent after:transition-all after:duration-300">Shop</a>
                    <a href="/cart" class="relative flex items-center gap-1.5 text-ink/80 hover:text-ink transition-colors duration-200 after:content-[''] after:absolute after:left-0 after:-bottom-1 after:h-[1.5px] after:w-0 hover:after:w-full after:bg-accent after:transition-all after:duration-300">
                        <i class="ri-shopping-bag-line text-base"></i> Cart
                    </a>
                    <a href="/logout" class="inline-flex items-center gap-1.5 text-ink/50 hover:text-red-600 transition-colors duration-200">
                        <i class="ri-logout-box-r-line"></i> Logout
                    </a>
                </div>
            <% } %>

            <% if (variant !== 'owner' && !loggedin) { %>
                <a href="/#auth" class="hidden md:inline-flex items-center gap-2 bg-ink text-paper text-sm font-medium px-5 py-2.5 rounded-full hover:bg-accent transition-colors duration-300">
                    <i class="ri-user-line"></i> Sign in
                </a>
            <% } %>

            <% if (variant === 'owner' || loggedin) { %>
            <button type="button" id="mobileMenuBtn" class="md:hidden w-10 h-10 flex items-center justify-center rounded-full border border-line text-ink text-xl" aria-label="Toggle menu">
                <i class="ri-menu-3-line" id="mobileMenuIcon"></i>
            </button>
            <% } %>
        </nav>

        <% if (variant === 'owner') { %>
        <div id="mobileMenu" class="mobile-menu md:hidden border-t border-line bg-paper px-5">
            <div class="flex flex-col py-4 gap-4 text-sm">
                <a href="/" class="text-ink/70"><i class="ri-store-2-line mr-2"></i>View store</a>
                <a href="/owners/logout" class="text-red-600"><i class="ri-logout-box-r-line mr-2"></i>Logout</a>
            </div>
        </div>
        <% } else if (loggedin) { %>
        <div id="mobileMenu" class="mobile-menu md:hidden border-t border-line bg-paper px-5">
            <div class="flex flex-col py-4 gap-4 text-sm font-medium">
                <a href="/shop" class="text-ink/80"><i class="ri-store-2-line mr-2"></i>Shop</a>
                <a href="/cart" class="text-ink/80"><i class="ri-shopping-bag-line mr-2"></i>Cart</a>
                <a href="/logout" class="text-red-600"><i class="ri-logout-box-r-line mr-2"></i>Logout</a>
            </div>
        </div>
        <% } %>
    </header>

<%- include('./partials/header', { loggedin: false, variant: 'guest' }) %>

<% if (typeof error !== 'undefined' && error.length > 0) { %>
    <div data-flash class="fixed top-20 left-1/2 -translate-x-1/2 z-50 animate-toast">
        <div class="flex items-center gap-2 px-4 py-3 rounded-xl bg-red-600 text-white text-sm shadow-lift">
            <i class="ri-error-warning-line"></i>
            <span><%= error %></span>
        </div>
    </div>
<% } %>

<main class="flex-1">

    <!-- ================= HERO + AUTH ================= -->
    <section class="relative overflow-hidden">
        <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-accent/10 blur-3xl"></div>
        <div class="absolute -bottom-32 -left-24 w-96 h-96 rounded-full bg-line/60 blur-3xl"></div>

        <div class="relative max-w-7xl mx-auto px-6 md:px-10 lg:px-16 pt-14 md:pt-20 pb-16 grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">

            <!-- Copy + visual -->
            <div class="animate-fade-up">
                <span class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-accent font-semibold mb-5">
                    <span class="w-6 h-px bg-accent"></span> New season, everyday carry
                </span>
                <h1 class="font-heading text-4xl sm:text-5xl lg:text-[3.4rem] leading-[1.08] text-ink mb-6">
                    Carry your world,
                    <span class="italic text-accent">beautifully.</span>
                </h1>
                <p class="text-muted text-base sm:text-lg leading-relaxed max-w-md mb-8">
                    Scatch designs durable, considered bags for the way you actually move —
                    from the daily commute to the weekend away.
                </p>

                <div class="flex flex-wrap items-center gap-4 mb-12">
                    <a href="#auth" data-tab-group="auth" data-tab-btn data-tab-target="register" onclick="document.getElementById('fullname-input')?.focus()"
                       class="inline-flex items-center gap-2 bg-ink text-paper px-6 py-3.5 rounded-full font-medium hover:bg-accent transition-colors duration-300 shadow-soft">
                        Get started <i class="ri-arrow-right-line"></i>
                    </a>
                    <a href="#auth" data-tab-group="auth" data-tab-btn data-tab-target="login"
                       class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full font-medium border border-line hover:border-ink transition-colors duration-300">
                        I already have an account
                    </a>
                </div>

                <!-- floating product imagery -->
                <div class="relative h-56 sm:h-64 hidden sm:block">
                    <div class="absolute left-6 top-2 w-36 sm:w-44 rounded-2xl bg-card shadow-card p-3 animate-float">
                        <img src="/images/4bag.png" alt="Leather backpack" class="w-full h-auto object-contain">
                    </div>
                    <div class="absolute left-40 sm:left-52 top-16 w-32 sm:w-40 rounded-2xl bg-card shadow-card p-3 animate-float-slow">
                        <img src="/images/image%2080.png" alt="Weekend duffel" class="w-full h-auto object-contain">
                    </div>
                    <div class="absolute left-[13rem] sm:left-[22rem] -top-2 w-28 sm:w-32 rounded-2xl bg-card shadow-card p-2.5 animate-float-delay">
                        <img src="/images/6bag.png" alt="Canvas tote" class="w-full h-auto object-contain">
                    </div>
                </div>
            </div>

            <!-- Auth card -->
            <div id="auth" class="animate-fade-up delay-2 scroll-mt-28">
                <div class="bg-card border border-line rounded-3xl shadow-card p-7 sm:p-9 max-w-md mx-auto lg:ml-auto">

                    <div class="flex items-center gap-2 mb-8 bg-paper rounded-full p-1 border border-line">
                        <button type="button" data-tab-group="auth" data-tab-btn data-tab-target="register"
                            class="tab-btn is-active flex-1 text-sm font-medium py-2.5 rounded-full transition-all duration-300">
                            Create account
                        </button>
                        <button type="button" data-tab-group="auth" data-tab-btn data-tab-target="login"
                            class="tab-btn flex-1 text-sm font-medium py-2.5 rounded-full transition-all duration-300">
                            Sign in
                        </button>
                    </div>

                    <!-- Register -->
                    <div data-tab-group="auth" data-tab-panel="register">
                        <h3 class="font-heading text-2xl text-ink mb-1">Create your account</h3>
                        <p class="text-sm text-muted mb-6">Join Scatch to start shopping the full collection.</p>
                        <form autocomplete="off" action="/users/register" method="post" class="space-y-4">
                            <div class="relative">
                                <i class="ri-user-line absolute left-4 top-1/2 -translate-y-1/2 text-muted"></i>
                                <input id="fullname-input"
                                    class="w-full pl-11 pr-4 py-3 bg-paper border border-line rounded-xl text-sm focus-ring transition-shadow duration-200"
                                    type="text" placeholder="Full name" name="fullname" required>
                            </div>
                            <div class="relative">
                                <i class="ri-mail-line absolute left-4 top-1/2 -translate-y-1/2 text-muted"></i>
                                <input
                                    class="w-full pl-11 pr-4 py-3 bg-paper border border-line rounded-xl text-sm focus-ring transition-shadow duration-200"
                                    type="email" placeholder="Email address" name="email" required>
                            </div>
                            <div class="relative">
                                <i class="ri-lock-line absolute left-4 top-1/2 -translate-y-1/2 text-muted"></i>
                                <input
                                    class="w-full pl-11 pr-4 py-3 bg-paper border border-line rounded-xl text-sm focus-ring transition-shadow duration-200"
                                    type="password" placeholder="Password" name="password" required>
                            </div>
                            <button type="submit"
                                class="w-full bg-ink text-paper py-3.5 rounded-xl font-medium hover:bg-accent transition-colors duration-300 mt-2">
                                Create my account
                            </button>
                        </form>
                    </div>

                    <!-- Login -->
                    <div data-tab-group="auth" data-tab-panel="login" class="hidden">
                        <h3 class="font-heading text-2xl text-ink mb-1">Welcome back</h3>
                        <p class="text-sm text-muted mb-6">Sign in to continue to your account.</p>
                        <form autocomplete="off" action="/users/login" method="post" class="space-y-4">
                            <div class="relative">
                                <i class="ri-mail-line absolute left-4 top-1/2 -translate-y-1/2 text-muted"></i>
                                <input
                                    class="w-full pl-11 pr-4 py-3 bg-paper border border-line rounded-xl text-sm focus-ring transition-shadow duration-200"
                                    type="email" placeholder="Email address" name="email" required>
                            </div>
                            <div class="relative">
                                <i class="ri-lock-line absolute left-4 top-1/2 -translate-y-1/2 text-muted"></i>
                                <input
                                    class="w-full pl-11 pr-4 py-3 bg-paper border border-line rounded-xl text-sm focus-ring transition-shadow duration-200"
                                    type="password" placeholder="Password" name="password" required>
                            </div>
                            <button type="submit"
                                class="w-full bg-ink text-paper py-3.5 rounded-xl font-medium hover:bg-accent transition-colors duration-300 mt-2">
                                Sign in
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </section>

    <!-- ================= VALUE PROPS ================= -->
    <section class="border-t border-line bg-card/60">
        <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-16 py-14 grid grid-cols-1 sm:grid-cols-3 gap-10">
            <div class="flex items-start gap-4 animate-fade-up">
                <span class="w-11 h-11 shrink-0 rounded-full bg-paper border border-line flex items-center justify-center text-accent text-lg">
                    <i class="ri-truck-line"></i>
                </span>
                <div>
                    <h4 class="font-semibold text-ink mb-1">Free shipping</h4>
                    <p class="text-sm text-muted leading-relaxed">On every order, every time — no fine print.</p>
                </div>
            </div>
            <div class="flex items-start gap-4 animate-fade-up delay-2">
                <span class="w-11 h-11 shrink-0 rounded-full bg-paper border border-line flex items-center justify-center text-accent text-lg">
                    <i class="ri-shield-check-line"></i>
                </span>
                <div>
                    <h4 class="font-semibold text-ink mb-1">Built to last</h4>
                    <p class="text-sm text-muted leading-relaxed">Durable materials and honest construction.</p>
                </div>
            </div>
            <div class="flex items-start gap-4 animate-fade-up delay-3">
                <span class="w-11 h-11 shrink-0 rounded-full bg-paper border border-line flex items-center justify-center text-accent text-lg">
                    <i class="ri-secure-payment-line"></i>
                </span>
                <div>
                    <h4 class="font-semibold text-ink mb-1">Secure checkout</h4>
                    <p class="text-sm text-muted leading-relaxed">Your details stay private, always.</p>
                </div>
            </div>
        </div>
    </section>

</main>

<%- include('./partials/footer') %>

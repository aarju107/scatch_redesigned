<%- include('./partials/header', { variant: 'owner' }) %>

<main class="flex-1">
    <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-16 py-10 flex flex-col lg:flex-row gap-10">

        <aside class="lg:w-60 shrink-0">
            <div class="lg:sticky lg:top-28">
                <h3 class="text-xs uppercase tracking-widest text-muted font-semibold mb-4">Admin panel</h3>
                <nav class="flex flex-col gap-1">
                    <a href="#" class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm font-medium bg-card border border-line text-ink">
                        <i class="ri-grid-line"></i> All products
                    </a>
                    <a href="/owners/admin" class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm text-ink/70 hover:bg-card transition-colors duration-200">
                        <i class="ri-add-circle-line"></i> Create new product
                    </a>
                </nav>
            </div>
        </aside>

        <div class="flex-1">
            <div class="flex items-center justify-between mb-6">
                <h1 class="font-heading text-3xl text-ink">All Products</h1>
                <a href="#" class="text-sm text-red-600 hover:text-red-700 transition-colors duration-200">
                    <i class="ri-delete-bin-line mr-1"></i> Delete all
                </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
                <% for (var i = 0; i < 8; i++) { %>
                    <div class="bg-card border border-line rounded-2xl overflow-hidden">
                        <div class="w-full h-52 bg-paper flex items-center justify-center text-muted text-2xl">
                            <i class="ri-image-line"></i>
                        </div>
                        <div class="flex justify-between items-center px-4 py-4">
                            <div>
                                <h3 class="font-medium text-ink">Clinge Bag</h3>
                                <h4 class="text-sm text-muted">₹1200</h4>
                            </div>
                            <a class="w-8 h-8 flex items-center justify-center rounded-full bg-ink text-paper hover:bg-accent transition-colors duration-300" href="#">
                                <i class="ri-add-line"></i>
                            </a>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<%- include('./partials/footer') %>

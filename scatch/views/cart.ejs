<%- include('./partials/header') %>

<main class="flex-1">

    <div class="bg-card border-b border-line">
        <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-16 py-10 animate-fade-up">
            <span class="text-xs uppercase tracking-[0.2em] text-accent font-semibold">Review your order</span>
            <h1 class="font-heading text-3xl sm:text-4xl text-ink mt-2">Your Cart</h1>
        </div>
    </div>

    <% if (user.cart.length === 0) { %>
        <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-16 py-24 flex flex-col items-center justify-center text-center">
            <span class="w-20 h-20 rounded-full bg-card border border-line flex items-center justify-center text-3xl text-muted mb-5">
                <i class="ri-shopping-bag-3-line"></i>
            </span>
            <h3 class="font-heading text-2xl text-ink mb-2">Your cart is empty</h3>
            <p class="text-sm text-muted mb-7 max-w-sm">Looks like you haven't added anything yet. Explore the collection and find something you'll love.</p>
            <a href="/shop" class="inline-flex items-center gap-2 bg-ink text-paper px-6 py-3 rounded-full font-medium hover:bg-accent transition-colors duration-300">
                Continue shopping <i class="ri-arrow-right-line"></i>
            </a>
        </div>
    <% } else { %>
        <div class="max-w-7xl mx-auto px-6 md:px-10 lg:px-16 py-10 grid grid-cols-1 lg:grid-cols-3 gap-10">

            <!-- Items -->
            <div class="lg:col-span-2 flex flex-col gap-4">
                <% user.cart.forEach(function (item, i) { %>
                    <%
                        var price = Number(item.price) || 0;
                        var discount = Number(item.discount) || 0;
                        var finalPrice = price - discount;
                    %>
                    <div class="flex items-center gap-4 sm:gap-6 bg-card border border-line rounded-2xl p-4 animate-fade-up" style="animation-delay: <%= Math.min(i, 8) * 0.06 %>s">
                        <div class="w-24 h-24 sm:w-28 sm:h-28 shrink-0 rounded-xl overflow-hidden flex items-center justify-center"
                             style="background-color: <%= item.bgcolor || '#F3EEE4' %>;">
                            <% if (item.image) { %>
                                <img class="w-full h-full object-contain p-2" src="<%= item.image %>" alt="<%= item.name %>">
                            <% } else { %>
                                <i class="ri-image-line text-2xl text-muted"></i>
                            <% } %>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-medium text-ink truncate"><%= item.name %></h3>
                            <div class="flex items-center gap-2 mt-1">
                                <span class="font-semibold text-ink">₹<%= finalPrice %></span>
                                <% if (discount > 0) { %>
                                    <span class="text-sm text-muted line-through">₹<%= price %></span>
                                <% } %>
                            </div>
                        </div>
                        <a href="/shop" class="hidden sm:inline-flex text-sm text-muted hover:text-ink transition-colors duration-200">
                            <i class="ri-add-line"></i> Add more
                        </a>
                    </div>
                <% }) %>
            </div>

            <!-- Summary -->
            <div class="lg:col-span-1">
                <div class="lg:sticky lg:top-28 bg-card border border-line rounded-2xl p-6 sm:p-7">
                    <h3 class="font-heading text-xl text-ink mb-5">Price Breakdown</h3>

                    <div class="space-y-3 text-sm">
                        <% user.cart.forEach(function (item) { %>
                            <div class="flex justify-between text-ink/80">
                                <span class="truncate pr-3"><%= item.name %> (MRP)</span>
                                <span class="shrink-0">₹<%= Number(item.price) %></span>
                            </div>
                            <% if (Number(item.discount) > 0) { %>
                                <div class="flex justify-between text-accent">
                                    <span>Discount</span>
                                    <span>− ₹<%= Number(item.discount) %></span>
                                </div>
                            <% } %>
                        <% }) %>
                        <div class="flex justify-between text-ink/80">
                            <span>Platform fee</span>
                            <span>₹20</span>
                        </div>
                        <div class="flex justify-between text-ink/80">
                            <span>Shipping fee</span>
                            <span class="text-green-600 font-medium">FREE</span>
                        </div>
                    </div>

                    <div class="h-px bg-line my-5"></div>

                    <div class="flex justify-between items-center mb-6">
                        <span class="font-heading text-lg text-ink">Total</span>
                        <span class="font-heading text-2xl text-ink">₹<%= bill %></span>
                    </div>

                    <button type="button" disabled title="Checkout is coming soon"
                        class="w-full bg-ink/30 text-paper py-3.5 rounded-full font-medium cursor-not-allowed flex items-center justify-center gap-2">
                        Proceed to checkout <i class="ri-lock-line"></i>
                    </button>
                    <p class="text-xs text-muted text-center mt-3">Checkout is coming soon</p>
                </div>
            </div>
        </div>
    <% } %>
</main>

<%- include('./partials/footer') %>
